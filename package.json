{
  "name": "@mivalabs/n8n-nodes-miva",
  "version": "1.0.5",
  "description": "n8n node to interact with Miva eCommerce API",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/mivaecommerce/n8n-nodes-miva",
  "author": {
    "name": "Developer Support Team",
    "email": "developer_support@miva.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mivaecommerce/n8n-nodes-miva.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && eslint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MivaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Miva/Miva.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@typescript-eslint/parser": "~8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.6",
    "gulp": "^5.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
