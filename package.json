{
    "name": "@mivalabs/n8n-nodes-miva",
    "version": "0.1.0",
    "description": "n8n node to interact with Miva eCommerce API",
    "keywords": [
        "n8n-community-node-package"
    ],
    "license": "MIT",
    "homepage": "https://github.com/mivaecommerce/n8n-nodes-miva",
    "author": {
        "name": "Developer Support Team",
        "email": "developer_support@miva.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mivaecommerce/n8n-nodes-miva.git"
    },
    "engines": {
        "node": ">=20.15"
    },
    "main": "nodes/Miva/index.js",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "format": "prettier nodes credentials --write"
    },
    "files": [
        "credentials",
        "nodes"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "credentials": [
            "credentials/MivaApi.credentials.js"
        ],
        "nodes": [
            "nodes/Miva/Miva.node.js"
        ]
    },
    "devDependencies": {
        "@types/node": "^24.2.0",
        "prettier": "^3.5.3",
        "typescript": "^5.8.2"
    },
    "peerDependencies": {
        "n8n-workflow": "1.17.0"
    },
    "overrides": {
        "axios": "^1.12.0",
        "form-data": "^4.0.4",
        "lodash": "^4.17.23"
    }
}
